# ==============================================================================
# CONFIGURACIÓN DEL MICROSERVICIO TTS LOCAL - SUDO-KILL-9
# ==============================================================================

# Dirección IP y puerto de escucha
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Voz predeterminada del jefe Windows en edge-tts:
# Opciones populares:
# - es-MX-JorgeNeural (Voz masculina autoritaria en español de México - RECOMENDADA)
# - es-ES-AlvaroNeural (Voz masculina en español de España)
# - en-US-ChristopherNeural (Voz ejecutiva y fría en inglés)
TTS_VOICE=es-MX-JorgeNeural

# Parámetros acústicos de la voz:
# Velocidad: "+5%", "+0%", "-10%"
TTS_RATE=+5%

# Volumen: "+0%", "-10%"
TTS_VOLUME=+0%

# Tono (Pitch): "-5Hz" (tono más grave y amenazante) o "+0Hz"
TTS_PITCH=-5Hz

# Longitud máxima permitida de caracteres por frase
TTS_MAX_TEXT_LENGTH=500

# Capacidad de la caché LRU en memoria RAM (número de audios cacheados)
LRU_CACHE_CAPACITY=128
